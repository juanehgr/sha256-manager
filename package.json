{
  "name": "sha256-manager",
  "version": "0.2.2",
  "description": "SHA-256 Manager: LAN discovery, pools and one-click pool switch",
  "author": "juanehgr",
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "release": "node scripts/release.cjs",
    "android": "npm run build && npx cap sync android",
    "android:apk": "npm run android && node scripts/build-apk.cjs"
  },
  "build": {
    "appId": "com.juanehgr.sha256manager",
    "productName": "SHA-256 Manager",
    "copyright": "Copyright © juanehgr",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SHA-256 Manager"
    },
    "portable": {
      "artifactName": "SHA-256-Manager-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "juanehgr",
      "repo": "sha256-manager",
      "private": false,
      "releaseType": "release"
    }
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^8.0.3"
  }
}
